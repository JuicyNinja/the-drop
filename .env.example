# The Drop: environment variables.
#
# This file is the provisioning checklist. Every variable the server reads is
# listed here with where it comes from. Copy to `.env.local` for development
# (gitignored). On Vercel, set each one per environment (Preview = staging,
# Production = production) under Project → Settings → Environment Variables.
#
# The schema is `lib/env.ts`. A missing or malformed value fails at boot with
# the variable's name.

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# Which deployment this is: local | staging | production
# Local: "local". Vercel Preview: "staging". Vercel Production: "production".
APP_ENV=local

# ---------------------------------------------------------------------------
# Supabase (one project per environment: the-drop-local, the-drop-staging,
# the-drop-production; local is `npx supabase start`)
# ---------------------------------------------------------------------------

# Supabase dashboard → Project Settings → API → Project URL
# Local: printed by `npx supabase start` as "API URL" (http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase dashboard → Project Settings → API → Project API keys → anon public
# Local: printed by `npx supabase start` as "anon key"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard → Project Settings → API → Project API keys → service_role
# Server only. Never prefixed NEXT_PUBLIC_. Never sent to a browser.
# Local: printed by `npx supabase start` as "service_role key"
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Upstash Redis (one database per environment: the-drop-local,
# the-drop-staging, the-drop-production)
# ---------------------------------------------------------------------------

# Upstash console → the database → REST API → UPSTASH_REDIS_REST_URL
# (Or Vercel → Storage → Upstash Redis → .env.local tab, same names.)
UPSTASH_REDIS_REST_URL=

# Upstash console → the database → REST API → UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Web app (WP-3)
# ---------------------------------------------------------------------------

# Public base URL of the web app, no trailing slash. OAuth redirect URI is
# built from it and return_to is validated against it. Local: http://127.0.0.1:3000
APP_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# SMS — Twilio (WP-3). Leave all three blank for the dev sender that logs the
# verification code to the server console instead of sending it.
# ---------------------------------------------------------------------------
# Twilio console → Account SID
TWILIO_ACCOUNT_SID=
# Twilio console → Auth Token
TWILIO_AUTH_TOKEN=
# A Twilio phone number or Messaging Service SID
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Email — Resend (WP-3). Blank → dev sender that logs the email.
# ---------------------------------------------------------------------------
# Resend dashboard → API Keys
RESEND_API_KEY=
# Verified From address, e.g. "The Drop <hello@thedrop.example>"
RESEND_FROM=

# ---------------------------------------------------------------------------
# Web Push — VAPID (WP-12). Blank → dev push sender that logs. Generate a
# keypair with `npx web-push generate-vapid-keys`. All three are required in
# production (a dev push sender must never ship).
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI for the push service, e.g. "mailto:ops@thedrop.example"
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# OAuth providers (WP-3). Blank → dev identity provider (a local consent stub;
# no external Google/Apple round trip). Fill to use real providers.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Billing — Stripe subscriptions (WP-6). Blank → dev subscription gateway
# (grants the upgrade with no charge). Required in production (fails at boot).
# ---------------------------------------------------------------------------
# Stripe dashboard → Developers → API keys → Secret key
STRIPE_SECRET_KEY=
